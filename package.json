{
  "name": "@bakapiano/codex-cli-schedule",
  "version": "0.1.1",
  "description": "Schedule prompts for existing or new Codex CLI sessions with a persistent daemon, CLI, and MCP tools.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakapiano/codex-cli-schedule.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": { "node": ">=24.0.0" },
  "bin": { "codex-schedule": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "README.zh-CN.md", "LICENSE", "docs"],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6",
    "cron-parser": "5.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
